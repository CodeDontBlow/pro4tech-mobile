{
  "expo": {
    "name": "Orbita",
    "slug": "OrbitaMobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Orbi.png",
    "scheme": "orbitamobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#F5F5F7",
        "foregroundImage": "./assets/images/Orbi.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.OrbitaMobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e169cc32-c607-4505-a788-8f5c3d820011"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e169cc32-c607-4505-a788-8f5c3d820011",
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "owner": "codedontblow"
  }
}
